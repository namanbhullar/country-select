{
    "name": "namanbhullar/country-select",
    "description": "Country select plugin for Craft CMS 5",
    "type": "craft-plugin",
    "require": {
        "php": "^8.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Manoj",
            "homepage": "https://github.com/namanbhullar"
        }
    ],
    "require": {
        "craftcms/cms": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
          "namanbhullar\\countryselect\\": "src/"
        }
    },
    "extra": {
        "name": "Country Select",
        "handle": "country-select",
        "hasCpSettings": false,
        "hasCpSection": false,
        "pluginClass": "namanbhullar\\countryselect\\CountrySelect"
    }
}
